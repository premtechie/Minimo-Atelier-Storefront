# Where the admin console lives. Only this site's servers call it, at
# ${ADMIN_URL}/api/v1/storefront/* (catalogue and photos). Server-only: never
# give these a NEXT_PUBLIC_ name, or they would be sent to browsers.
ADMIN_URL=https://admin.minimoatelier.in

# Shared secret for those calls. The same value as STOREFRONT_API_KEY on the
# admin project. Make one with: openssl rand -base64 48
ADMIN_API_KEY=

# WhatsApp number for orders and questions, digits only with country code
# (e.g. 919876543210). Left empty, WhatsApp links open the share picker.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# This site's own address, for share links, the sitemap and social cards.
NEXT_PUBLIC_SITE_URL=https://www.minimoatelier.in

# Development only: read the catalogue from a JSON file instead of the admin.
# CATALOGUE_FIXTURE=/path/to/catalogue.json
